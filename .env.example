# Example environment variables for vanilla-hn
# Copy this file to `.env` or `.env.local` and fill in real values for local development.
# Do NOT commit real credentials to source control.
#
# Notes:
# - FIREBASE_* values are optional for mock/development mode. If you don't provide them,
#   the app will run in mock mode by default (see HN_SERVICE_MOCK).
# - For minimal local testing without a bundler, you can keep the dev server port below.
# - This file is intentionally simple; adapt to your deployment pipeline as needed.

# Runtime
NODE_ENV=development
DEV_SERVER_PORT=5000
PUBLIC_DIR=public

# Toggle: run HN service in mock mode (true|false)
# When true, the bundled HNService will use the built-in mock backend.
HN_SERVICE_MOCK=true

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Firebase configuration (example placeholders)
# If you supply these values, HNService can be wired to a Firebase Realtime Database.
# Replace the example values with your project's configuration (do not commit real values).
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: override the database URL used by the app (useful for staging)
# HN_DB_URL=https://your-staging-db.firebaseio.com

# Example of a feature flag: enable experimental virtual scroller
# VIRTUAL_SCROLLER_ENABLED=false

# End of example .env
